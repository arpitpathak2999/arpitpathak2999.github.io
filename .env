# ─────────────────────────────────────────────────────────────────────────────
#  WHERE THE SITE LIVES — this is the only place the URL is written down.
#  It feeds the canonical link, Open Graph tags, sitemap.xml, robots.txt and
#  the CNAME file. Change it here and everything else follows on next build.
# ─────────────────────────────────────────────────────────────────────────────

# The public address of the site, no trailing slash.
VITE_SITE_URL=https://arpitpathak2999.github.io

# Leave EMPTY until you actually own the domain AND its DNS records point at
# GitHub. Setting it writes a CNAME file into the build, which tells GitHub
# Pages to serve the site at that domain — if DNS is not ready yet, the site
# breaks. When you are ready, the switch is these two lines:
#
#   VITE_SITE_URL=https://arpitpathak2999.com
#   VITE_CUSTOM_DOMAIN=arpitpathak2999.com
#
VITE_CUSTOM_DOMAIN=
